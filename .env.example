# Server-side only — injected into dist/api/config.php for Hostinger deploys.
ALIGNO_USER_API_KEY=your_aligno_api_key_here
# Optional override (defaults to Aligno CRM webhook)
ALIGNO_LEAD_WEBHOOK_URL=https://alignocrm.com/api/webhooks/lead

# Lead form email notifications
LEAD_NOTIFY_TO=rpearson@raypearsonlawgroup.com
LEAD_NOTIFY_BCC=aki.b@pentridgemedia.com
LEAD_NOTIFY_FROM=contact@raypearsonlawgroup.com
LEAD_NOTIFY_FROM_NAME=Law Office of Ray L. Pearson

# Optional override for the configured Pentridge Default project (642504).
# Public project ingestion token only, never a personal API key.
PUBLIC_POSTHOG_KEY=
# US: https://us.i.posthog.com | EU: https://eu.i.posthog.com
PUBLIC_POSTHOG_HOST=
