---
import Layout from '../layouts/Layout.astro';
import { officeAddressLines, officeMapsUrl } from '../data/contact';
---

<Layout
	title="Personal Injury Attorney | Law Office of Ray L. Pearson, LLC"
	shareTitle="Personal Injury Attorney | Law Office of Ray L. Pearson, LLC"
>
    
    <!-- Hero Section -->
    <section id="home" class="relative min-h-[90vh] flex items-center justify-center pt-20 overflow-hidden bg-slate-900">
        <!-- Video Background -->
        <div class="absolute inset-0 z-0 overflow-hidden bg-slate-900">
            <!-- Overlays for readability -->
            <div class="absolute inset-0 bg-slate-900/70 z-10 mix-blend-multiply"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent z-10"></div>
            
            <!-- Background Video -->
            <video 
                autoplay 
                loop 
                muted 
                playsinline 
                class="absolute inset-0 w-full h-full object-cover opacity-50 scale-105"
                poster="/images/car-wreck.png"
            >
                <source src="/images/hero-bg.mp4" type="video/mp4" />
                <img src="/images/car-wreck.png" alt="Car Accident" class="w-full h-full object-cover opacity-100" />
            </video>
        </div>
        
        <div class="container mx-auto px-6 relative z-20 flex flex-col md:flex-row items-center justify-between">
            <div class="w-full md:w-1/2 text-left pt-10">
                <h1 class="reveal-up delay-100 text-4xl sm:text-6xl md:text-8xl font-bold leading-[1.1] mb-6 text-white text-balance">
                    Protecting Your <span class="text-gold italic pr-2">Rights.</span> <br/>Securing Your Future.
                </h1>
                <p class="reveal-up delay-200 text-lg md:text-xl text-gray-300 mb-10 max-w-xl font-light leading-relaxed">
                    Dependable representation for individuals navigating motor vehicle accidents and criminal charges. When it matters most, we are here to guide and protect you.
                </p>
                <div class="reveal-up delay-300 flex flex-col sm:flex-row gap-5">
                    <a href="tel:4047199561" class="bg-gold hover:bg-gold-light text-slate-900 font-bold text-sm tracking-wider uppercase px-10 py-5 rounded-sm text-center transition-all shadow-[0_0_20px_rgba(212,175,55,0.4)] hover:shadow-[0_0_30px_rgba(212,175,55,0.6)] transform hover:-translate-y-1">
                        Call Now
                    </a>
                </div>
            </div>
            
            <!-- Contact Form Card on Hero -->
            <div class="w-full md:w-5/12 mt-16 md:mt-0 reveal-right delay-400">
                <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-xl shadow-2xl p-8 max-w-md mx-auto relative overflow-hidden group hover:border-gold/30 transition-colors duration-500">
                    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-gold to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                    
                    <h3 class="text-3xl font-serif text-white mb-2">Speak to Ray</h3>
                    <p class="text-gray-400 mb-8 font-light text-sm">Submit your details for an immediate case evaluation.</p>
                    
                    <form data-lead-form data-lead-form-theme="dark" class="space-y-5 relative z-10" novalidate>
                        <div class="space-y-4">
                            <input type="text" name="name" autocomplete="name" class="w-full px-5 py-4 bg-slate-900/50 border border-gray-700 text-white placeholder-gray-500 focus:ring-1 focus:ring-gold focus:border-gold rounded-sm transition-all outline-none" placeholder="Full Name" required />
                            
                            <input type="email" name="email" autocomplete="email" class="w-full px-5 py-4 bg-slate-900/50 border border-gray-700 text-white placeholder-gray-500 focus:ring-1 focus:ring-gold focus:border-gold rounded-sm transition-all outline-none" placeholder="Email Address" required />
                            
                            <input type="tel" name="phone" autocomplete="tel" class="w-full px-5 py-4 bg-slate-900/50 border border-gray-700 text-white placeholder-gray-500 focus:ring-1 focus:ring-gold focus:border-gold rounded-sm transition-all outline-none" placeholder="Phone Number" required />
                            
                            <textarea name="message" rows="3" class="w-full px-5 py-4 bg-slate-900/50 border border-gray-700 text-white placeholder-gray-500 focus:ring-1 focus:ring-gold focus:border-gold rounded-sm transition-all outline-none resize-none" placeholder="Briefly describe what happened..."></textarea>
                        </div>
                        <button type="submit" class="w-full bg-white hover:bg-gray-100 text-slate-900 font-bold py-4 px-4 rounded-sm transition-all uppercase tracking-widest text-sm mt-2 shadow-lg">
                            Submit
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="py-12 bg-gold relative z-20 shadow-2xl">
        <div class="container mx-auto px-6">
            <div class="flex flex-wrap justify-center gap-12 md:gap-24 text-slate-900 text-center">
                <div class="reveal-up delay-100 flex flex-col">
                    <span class="text-4xl md:text-5xl font-serif font-bold mb-1">100%</span>
                    <span class="text-xs uppercase tracking-widest font-bold opacity-80">Committed to Clients</span>
                </div>
                <div class="reveal-up delay-200 flex flex-col">
                    <span class="text-4xl md:text-5xl font-serif font-bold mb-1">24/7</span>
                    <span class="text-xs uppercase tracking-widest font-bold opacity-80">Availability</span>
                </div>
                <div class="reveal-up delay-300 flex flex-col">
                    <span class="text-4xl md:text-5xl font-serif font-bold mb-1">Results</span>
                    <span class="text-xs uppercase tracking-widest font-bold opacity-80">Driven Strategy</span>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="py-32 bg-white overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="flex flex-col md:flex-row items-center gap-20">
                <div class="w-full md:w-5/12 reveal-left">
                    <div class="relative group">
                        <div class="absolute inset-0 bg-gold translate-x-4 translate-y-4 rounded-sm transition-transform duration-500 group-hover:translate-x-6 group-hover:translate-y-6"></div>
                        <img src="/images/ray-pearson.png" alt="Attorney Ray Pearson" class="relative rounded-sm shadow-2xl w-full object-cover z-10 grayscale-[20%] group-hover:grayscale-0 transition-all duration-700" />
                    </div>
                </div>
                <div class="w-full md:w-7/12 reveal-right delay-200">
                    <h2 class="text-sm font-bold text-gold uppercase tracking-[0.2em] mb-4 flex items-center">
                        <span class="w-12 h-px bg-gold mr-4"></span> The Attorney
                    </h2>
                    <h3 class="text-5xl md:text-6xl font-serif text-slate-900 mb-8 leading-tight">Meet <span class="italic text-gold">Ray L. Pearson</span></h3>
                    <div class="space-y-6 text-lg text-gray-600 font-light leading-relaxed">
                        <p class="first-letter:text-7xl first-letter:font-serif first-letter:text-slate-900 first-letter:float-left first-letter:pr-4 first-letter:pt-2">
                            Personal Injury and Criminal Defense are the primary focus of the Law Office of Ray L. Pearson, LLC. Our firm is dedicated to protecting the rights of individuals who have been injured in car or trucking accidents due to another's negligence.
                        </p>
                        <p>
                            We provide strategic, results-driven representation for clients facing misdemeanor and felony criminal charges. We understand that legal problems can be overwhelming, which is why we work tirelessly to investigate your case, advocate on your behalf, and guide you through every step of the legal process.
                        </p>
                        <blockquote class="border-l-4 border-gold pl-6 italic text-xl text-slate-800 my-8 py-2">
                            "Whether pursuing compensation for injury victims or defending clients against criminal allegations, we strive to achieve the best possible outcome."
                        </blockquote>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Swiper Slider Section: Cases We Handle -->
    <section class="py-24 bg-slate-50 border-y border-gray-200">
        <div class="container mx-auto px-6">
            <div class="flex flex-col md:flex-row justify-between items-end mb-16 reveal-up">
                <div class="max-w-2xl">
                    <h2 class="text-sm font-bold text-gold uppercase tracking-[0.2em] mb-4">Our Expertise</h2>
                    <h3 class="text-4xl md:text-5xl font-serif text-slate-900">Cases We Handle</h3>
                </div>
                <div class="mt-6 md:mt-0">
                    <a href="/contact" class="text-slate-900 font-bold uppercase tracking-widest text-sm border-b-2 border-gold pb-1 hover:text-gold transition-colors flex items-center">
                        Get Help Now
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                    </a>
                </div>
            </div>

            <!-- Swiper -->
            <div class="swiper mySwiper pb-12 reveal-up delay-200">
                <div class="swiper-wrapper">
                    <!-- Slide 1: Car Accidents 1 -->
                    <div class="swiper-slide">
                        <div class="relative group overflow-hidden rounded-sm cursor-pointer h-[400px]">
                            <img src="/images/car-wreck.png" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" alt="Car Accidents" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-500"></div>
                            <div class="absolute bottom-0 left-0 p-8 w-full transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                <h4 class="text-3xl font-serif text-white mb-2">Car Accidents</h4>
                            </div>
                        </div>
                    </div>
                    <!-- Slide 2: Trucking Accidents 1 -->
                    <div class="swiper-slide">
                        <div class="relative group overflow-hidden rounded-sm cursor-pointer h-[400px]">
                            <img src="/images/truck-wreck.png" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" alt="Trucking Accidents" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-500"></div>
                            <div class="absolute bottom-0 left-0 p-8 w-full transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                <h4 class="text-3xl font-serif text-white mb-2">Trucking Accidents</h4>
                            </div>
                        </div>
                    </div>
                    <!-- Slide 3: Car Accidents 2 -->
                    <div class="swiper-slide">
                        <div class="relative group overflow-hidden rounded-sm cursor-pointer h-[400px]">
                            <img src="/images/car-wreck-2.png" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" alt="Auto Collisions" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-500"></div>
                            <div class="absolute bottom-0 left-0 p-8 w-full transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                <h4 class="text-3xl font-serif text-white mb-2">Auto Collisions</h4>
                            </div>
                        </div>
                    </div>
                    <!-- Slide 4: Trucking Accidents 2 -->
                    <div class="swiper-slide">
                        <div class="relative group overflow-hidden rounded-sm cursor-pointer h-[400px]">
                            <img src="/images/truck-wreck-2.png" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" alt="Commercial Vehicle Crashes" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-500"></div>
                            <div class="absolute bottom-0 left-0 p-8 w-full transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                <h4 class="text-3xl font-serif text-white mb-2">Commercial Vehicles</h4>
                            </div>
                        </div>
                    </div>
                    <!-- Slide 5: Car Accidents 3 -->
                    <div class="swiper-slide">
                        <div class="relative group overflow-hidden rounded-sm cursor-pointer h-[400px]">
                            <img src="/images/car-wreck-3.png" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" alt="Intersection Accidents" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-500"></div>
                            <div class="absolute bottom-0 left-0 p-8 w-full transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                <h4 class="text-3xl font-serif text-white mb-2">Intersection Accidents</h4>
                            </div>
                        </div>
                    </div>
                    <!-- Slide 6: Highway Accidents -->
                    <div class="swiper-slide">
                        <div class="relative group overflow-hidden rounded-sm cursor-pointer h-[400px]">
                            <img src="/images/highway-accident.png" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" alt="Highway Accidents" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-500"></div>
                            <div class="absolute bottom-0 left-0 p-8 w-full transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                <h4 class="text-3xl font-serif text-white mb-2">Highway Accidents</h4>
                            </div>
                        </div>
                    </div>
                    <!-- Slide 7: Criminal Defense (Gavel) -->
                    <div class="swiper-slide">
                        <div class="relative group overflow-hidden rounded-sm cursor-pointer h-[400px]">
                            <img src="/images/gavel.png" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" alt="Criminal Defense" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-500"></div>
                            <div class="absolute bottom-0 left-0 p-8 w-full transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                <h4 class="text-3xl font-serif text-white mb-2">Criminal Defense</h4>
                            </div>
                        </div>
                    </div>
                    <!-- Slide 8: Criminal Defense (Police Lights) -->
                    <div class="swiper-slide">
                        <div class="relative group overflow-hidden rounded-sm cursor-pointer h-[400px]">
                            <img src="/images/police-lights.png" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" alt="DUI & Misdemeanors" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-500"></div>
                            <div class="absolute bottom-0 left-0 p-8 w-full transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                <h4 class="text-3xl font-serif text-white mb-2">DUI & Misdemeanors</h4>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="swiper-pagination"></div>
            </div>
        </div>
    </section>

    <!-- Testimonial Section -->
    <section class="py-32 bg-slate-900 text-white relative overflow-hidden">
        <div class="absolute top-0 right-0 w-96 h-96 bg-gold rounded-full mix-blend-multiply filter blur-[128px] opacity-20 animate-pulse"></div>
        <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-900 rounded-full mix-blend-multiply filter blur-[128px] opacity-30 animate-pulse delay-1000"></div>
        
        <div class="container mx-auto px-6 relative z-10 text-center reveal-up">
            <p class="text-sm font-bold text-gold uppercase tracking-[0.2em] mb-6">Client Praise</p>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 mx-auto text-gold mb-10 opacity-50" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>
            <blockquote class="text-3xl md:text-5xl font-serif italic text-white leading-relaxed max-w-5xl mx-auto drop-shadow-lg">
                "Ray Pearson handled my case with care and skill, securing a settlement that truly changed my life."
            </blockquote>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-0 relative">
        <div class="flex flex-col md:flex-row min-h-[70vh]">
            <div class="w-full md:w-1/2 bg-slate-900 p-6 sm:p-12 md:p-24 flex flex-col justify-center text-white relative overflow-hidden reveal-left">
                <!-- Background Pattern -->
                <div class="absolute inset-0 opacity-5 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI4IiBoZWlnaHQ9IjgiPgo8cmVjdCB3aWR0aD0iOCIgaGVpZ2h0PSI4IiBmaWxsPSIjZmZmIiBmaWxsLW9wYWNpdHk9IjAuMSI+PC9yZWN0Pgo8cGF0aCBkPSJNMCAwTDggOFpNOCAwTDAgOFoiIHN0cm9rZT0iIzAwMCIgc3Ryb2tlLW9wYWNpdHk9IjAuMSI+PC9wYXRoPgo8L3N2Zz4=')]"></div>
                
                <div class="relative z-10">
                    <h2 class="text-sm font-bold text-gold uppercase tracking-[0.2em] mb-4">Call Now</h2>
                    <h3 class="text-3xl sm:text-5xl md:text-6xl font-serif text-white mb-8">Dedicated Support. <br/><span class="italic text-gray-400">Proven Results.</span></h3>
                    <p class="text-lg sm:text-xl text-gray-300 mb-12 font-light leading-relaxed max-w-lg">
                        You need an attorney who listens, understands, and fiercely protects your interests. Contact us today for a confidential, no-cost assessment.
                    </p>
                    
                    <div class="space-y-6 sm:space-y-8">
                        <div class="flex items-start gap-4 min-w-0 group">
                            <div class="bg-gold/10 rounded-full p-3 sm:p-4 shrink-0 border border-gold/20 group-hover:bg-gold transition-colors duration-300">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gold group-hover:text-slate-900" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                </svg>
                            </div>
                            <a href="tel:4047199561" class="contact-link text-2xl sm:text-3xl font-serif text-white pt-1">(404) 719-9561</a>
                        </div>
                        <div class="flex items-start gap-4 min-w-0 group">
                            <div class="bg-gold/10 rounded-full p-3 sm:p-4 shrink-0 border border-gold/20 group-hover:bg-gold transition-colors duration-300">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gold group-hover:text-slate-900" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <a href="mailto:rpearson@raypearsonlawgroup.com" class="contact-link text-sm sm:text-base md:text-xl font-light text-white leading-snug pt-1">rpearson@raypearsonlawgroup.com</a>
                        </div>
                        <div class="flex items-start gap-4 min-w-0 group">
                            <div class="bg-gold/10 rounded-full p-3 sm:p-4 shrink-0 border border-gold/20 group-hover:bg-gold transition-colors duration-300">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gold group-hover:text-slate-900" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </div>
                            <a href={officeMapsUrl} target="_blank" rel="noopener noreferrer" class="contact-link text-sm sm:text-base md:text-lg font-light text-white leading-snug pt-1">
                                {officeAddressLines.map((line) => (
                                    <span class="block">{line}</span>
                                ))}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="w-full md:w-1/2 bg-gray-50 p-6 sm:p-12 md:p-24 flex flex-col justify-center reveal-right delay-200">
                <div class="max-w-lg w-full">
                    <h3 class="text-3xl font-serif text-slate-900 mb-2">Free Case Evaluation</h3>
                    <p class="text-gray-500 mb-10 font-light">Fill out the form below and our team will contact you immediately.</p>
                    
                    <form data-lead-form class="space-y-6" novalidate>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="relative">
                                <input type="text" name="firstName" id="evalFirstName" autocomplete="given-name" class="peer w-full px-0 py-3 bg-transparent border-0 border-b-2 border-gray-300 text-slate-900 placeholder-transparent focus:ring-0 focus:border-gold transition-colors" placeholder="First Name" required />
                                <label for="evalFirstName" class="absolute left-0 -top-3.5 text-gray-500 text-sm transition-all peer-placeholder-shown:text-base peer-placeholder-shown:top-3 peer-focus:-top-3.5 peer-focus:text-gold peer-focus:text-sm">First Name</label>
                            </div>
                            <div class="relative">
                                <input type="text" name="lastName" id="evalLastName" autocomplete="family-name" class="peer w-full px-0 py-3 bg-transparent border-0 border-b-2 border-gray-300 text-slate-900 placeholder-transparent focus:ring-0 focus:border-gold transition-colors" placeholder="Last Name" required />
                                <label for="evalLastName" class="absolute left-0 -top-3.5 text-gray-500 text-sm transition-all peer-placeholder-shown:text-base peer-placeholder-shown:top-3 peer-focus:-top-3.5 peer-focus:text-gold peer-focus:text-sm">Last Name</label>
                            </div>
                        </div>
                        <div class="relative mt-8">
                            <input type="email" name="email" id="evalEmail" autocomplete="email" class="peer w-full px-0 py-3 bg-transparent border-0 border-b-2 border-gray-300 text-slate-900 placeholder-transparent focus:ring-0 focus:border-gold transition-colors" placeholder="Email Address" required />
                            <label for="evalEmail" class="absolute left-0 -top-3.5 text-gray-500 text-sm transition-all peer-placeholder-shown:text-base peer-placeholder-shown:top-3 peer-focus:-top-3.5 peer-focus:text-gold peer-focus:text-sm">Email Address</label>
                        </div>
                        <div class="relative mt-8">
                            <input type="tel" name="phone" id="evalPhone" autocomplete="tel" class="peer w-full px-0 py-3 bg-transparent border-0 border-b-2 border-gray-300 text-slate-900 placeholder-transparent focus:ring-0 focus:border-gold transition-colors" placeholder="Phone Number" required />
                            <label for="evalPhone" class="absolute left-0 -top-3.5 text-gray-500 text-sm transition-all peer-placeholder-shown:text-base peer-placeholder-shown:top-3 peer-focus:-top-3.5 peer-focus:text-gold peer-focus:text-sm">Phone Number</label>
                        </div>
                        <div class="relative mt-8">
                            <textarea name="message" id="evalMessage" rows="4" class="peer w-full px-0 py-3 bg-transparent border-0 border-b-2 border-gray-300 text-slate-900 placeholder-transparent focus:ring-0 focus:border-gold transition-colors resize-none mt-2" placeholder="Briefly describe what happened..." required></textarea>
                            <label for="evalMessage" class="absolute left-0 -top-1.5 text-gray-500 text-sm transition-all peer-placeholder-shown:text-base peer-placeholder-shown:top-5 peer-focus:-top-1.5 peer-focus:text-gold peer-focus:text-sm">Case Details</label>
                        </div>
                        <button type="submit" class="group relative w-full bg-slate-900 text-white font-bold text-sm tracking-widest uppercase px-8 py-5 mt-6 rounded-sm overflow-hidden">
                            <span class="relative z-10 group-hover:text-slate-900 transition-colors duration-500">Submit Information</span>
                            <div class="absolute inset-0 h-full w-full scale-0 rounded-sm transition-all duration-500 ease-out group-hover:scale-100 group-hover:bg-gold"></div>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>
</Layout>
