---
import Layout from '../layouts/Layout.astro';
import { officeAddressLines, officeMapsEmbedUrl, officeMapsUrl } from '../data/contact';
---

<Layout title="Contact | Law Office of Ray L. Pearson, LLC">
    
    <!-- Parallax Hero -->
    <section class="relative min-h-[55vh] md:min-h-[75vh] flex items-center justify-center pt-32 pb-16 md:pb-24 overflow-hidden">
        <div class="parallax-bg absolute inset-0" style="background-image: url('/images/contact-parallax-hero.png');"></div>
        <div class="absolute inset-0 bg-slate-900/65 mix-blend-multiply"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-slate-900/85 via-slate-900/45 to-slate-900/80"></div>

        <div class="container mx-auto px-6 relative z-10 text-center reveal-up">
            <h1 class="text-4xl sm:text-5xl md:text-7xl font-serif font-bold mb-4 text-white drop-shadow-lg">Contact Us</h1>
            <div class="w-24 h-1 bg-gold mx-auto mb-6"></div>
            <p class="text-xl text-gray-200 font-light max-w-2xl mx-auto drop-shadow-md">We are standing by to review your case at no cost.</p>
        </div>
    </section>

    <!-- Contact Form Section -->
    <section class="py-24 bg-gray-50 overflow-hidden relative">
        <!-- Abstract background pattern -->
        <div class="absolute top-0 right-0 w-96 h-96 bg-gold rounded-full mix-blend-multiply filter blur-[128px] opacity-10 animate-pulse"></div>

        <div class="container mx-auto px-4 max-w-7xl relative z-10">
            <div class="flex flex-col lg:flex-row bg-white rounded-sm shadow-2xl overflow-hidden reveal-up">
                
                <div class="w-full lg:w-1/2 bg-slate-900 flex flex-col text-white relative">
                    <div class="absolute inset-0 opacity-5 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI4IiBoZWlnaHQ9IjgiPgo8cmVjdCB3aWR0aD0iOCIgaGVpZ2h0PSI4IiBmaWxsPSIjZmZmIiBmaWxsLW9wYWNpdHk9IjAuMSI+PC9yZWN0Pgo8cGF0aCBkPSJNMCAwTDggOFpNOCAwTDAgOFoiIHN0cm9rZT0iIzAwMCIgc3Ryb2tlLW9wYWNpdHk9IjAuMSI+PC9wYXRoPgo8L3N2Zz4=')]"></div>
                    <div class="p-6 sm:p-12 lg:p-20 relative z-10 flex-shrink-0">
                        <h2 class="text-3xl sm:text-5xl font-serif text-gold mb-6">Case Review</h2>
                        <p class="text-lg sm:text-xl text-gray-300 font-light mb-8 leading-relaxed">
                            Don't wait. The sooner you contact us, the faster we can begin building your defense or personal injury claim.
                        </p>
                        <div class="space-y-4">
                            <div class="flex items-start gap-3 sm:gap-4 min-w-0">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gold shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                                <a href="tel:4047199561" class="contact-link text-xl sm:text-2xl font-serif">(404) 719-9561</a>
                            </div>
                            <div class="flex items-start gap-3 sm:gap-4 min-w-0">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gold shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                                <a href="mailto:rpearson@raypearsonlawgroup.com" class="contact-link text-sm sm:text-base md:text-lg font-light leading-snug">rpearson@raypearsonlawgroup.com</a>
                            </div>
                            <div class="flex items-start gap-3 sm:gap-4 min-w-0">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gold shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                <a href={officeMapsUrl} target="_blank" rel="noopener noreferrer" class="contact-link text-sm sm:text-base md:text-lg font-light leading-snug">
                                    {officeAddressLines.map((line) => (
                                        <span class="block">{line}</span>
                                    ))}
                                </a>
                            </div>
                        </div>
                    </div>
                    <!-- Map Featured Prominently -->
                    <div class="relative flex-grow min-h-[400px] lg:min-h-[500px] w-full border-t border-gray-800">
                        <iframe src={officeMapsEmbedUrl} width="100%" height="100%" style="border:0; position: absolute; top:0; left:0; width:100%; height:100%;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Office location map"></iframe>
                    </div>
                </div>
                
                <div class="w-full lg:w-1/2 p-6 sm:p-12 lg:p-20 flex flex-col justify-center bg-white">
                    <h3 class="text-4xl font-serif text-slate-900 mb-4">Free Case Evaluation</h3>
                    <p class="text-xl text-gray-500 mb-12 font-light">Fill out the form below and we will contact you immediately.</p>
                    
                    <form data-lead-form class="space-y-8" novalidate>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div class="relative">
                                <input type="text" name="firstName" id="contactFirstName" autocomplete="given-name" class="peer w-full px-0 py-4 bg-transparent border-0 border-b-2 border-gray-300 text-slate-900 text-lg placeholder-transparent focus:ring-0 focus:border-gold transition-colors" placeholder="First Name" required />
                                <label for="contactFirstName" class="absolute left-0 -top-3.5 text-gray-500 text-sm transition-all peer-placeholder-shown:text-lg peer-placeholder-shown:top-4 peer-focus:-top-3.5 peer-focus:text-gold peer-focus:text-sm">First Name</label>
                            </div>
                            <div class="relative">
                                <input type="text" name="lastName" id="contactLastName" autocomplete="family-name" class="peer w-full px-0 py-4 bg-transparent border-0 border-b-2 border-gray-300 text-slate-900 text-lg placeholder-transparent focus:ring-0 focus:border-gold transition-colors" placeholder="Last Name" required />
                                <label for="contactLastName" class="absolute left-0 -top-3.5 text-gray-500 text-sm transition-all peer-placeholder-shown:text-lg peer-placeholder-shown:top-4 peer-focus:-top-3.5 peer-focus:text-gold peer-focus:text-sm">Last Name</label>
                            </div>
                        </div>
                        <div class="relative">
                            <input type="email" name="email" id="contactEmail" autocomplete="email" class="peer w-full px-0 py-4 bg-transparent border-0 border-b-2 border-gray-300 text-slate-900 text-lg placeholder-transparent focus:ring-0 focus:border-gold transition-colors" placeholder="Email Address" required />
                            <label for="contactEmail" class="absolute left-0 -top-3.5 text-gray-500 text-sm transition-all peer-placeholder-shown:text-lg peer-placeholder-shown:top-4 peer-focus:-top-3.5 peer-focus:text-gold peer-focus:text-sm">Email Address</label>
                        </div>
                        <div class="relative">
                            <input type="tel" name="phone" id="contactPhone" autocomplete="tel" class="peer w-full px-0 py-4 bg-transparent border-0 border-b-2 border-gray-300 text-slate-900 text-lg placeholder-transparent focus:ring-0 focus:border-gold transition-colors" placeholder="Phone Number" required />
                            <label for="contactPhone" class="absolute left-0 -top-3.5 text-gray-500 text-sm transition-all peer-placeholder-shown:text-lg peer-placeholder-shown:top-4 peer-focus:-top-3.5 peer-focus:text-gold peer-focus:text-sm">Phone Number</label>
                        </div>
                        <div class="relative mt-12">
                            <textarea name="message" id="contactMessage" rows="5" class="peer w-full px-0 py-4 bg-transparent border-0 border-b-2 border-gray-300 text-slate-900 text-lg placeholder-transparent focus:ring-0 focus:border-gold transition-colors resize-none" placeholder="Briefly describe what happened..." required></textarea>
                            <label for="contactMessage" class="absolute left-0 -top-1.5 text-gray-500 text-sm transition-all peer-placeholder-shown:text-lg peer-placeholder-shown:top-4 peer-focus:-top-1.5 peer-focus:text-gold peer-focus:text-sm">Case Details</label>
                        </div>
                        <button type="submit" class="group relative w-full bg-slate-900 text-white font-bold text-lg tracking-widest uppercase px-8 py-6 mt-8 rounded-sm overflow-hidden">
                            <span class="relative z-10 group-hover:text-slate-900 transition-colors duration-500">Submit Information</span>
                            <div class="absolute inset-0 h-full w-full scale-0 rounded-sm transition-all duration-500 ease-out group-hover:scale-100 group-hover:bg-gold"></div>
                        </button>
                        <p class="text-sm text-gray-400 mt-6 text-center">By submitting this form, you consent to our <a href="/policy" class="underline hover:text-gold">Privacy Policy</a>.</p>
                    </form>
                </div>
            </div>
        </div>
    </section>

</Layout>
